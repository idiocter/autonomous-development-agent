# --- LLM ---
ANTHROPIC_API_KEY=

# Per-agent model overrides (defaults shown)
PLANNER_MODEL=claude-opus-5
CODER_MODEL=claude-sonnet-5
TESTING_MODEL=claude-sonnet-5
DEBUGGER_MODEL=claude-opus-5

# --- Loop safety ---
# Test files are refused by the write tools. Only turn this on for a job whose
# actual purpose is changing tests -- never for issue-triggered runs on a repo
# where anyone can file an issue.
ALLOW_TEST_EDITS=false
MAX_ITERATIONS=6
JOB_TIMEOUT_SECONDS=2700
JOB_COST_BUDGET_USD=2.00

# --- GitHub (Phase 2+) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- Docker sandbox (Phase 3+) ---
SANDBOX_IMAGE=autonomous-dev-agent-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300

# --- Database / RAG (Phase 3+/4+) ---
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/autonomous_dev_agent
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
