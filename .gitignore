# `.env` alone matches only that exact name -- .env.local, .env.production and
# .env.backup would all still be committable.
.env
.env.*
!.env.example
.venv/
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# per-job workspaces (Phase 2+)
/workspaces/

# local Postgres data volume (Phase 3+)
/docker/postgres/data/
